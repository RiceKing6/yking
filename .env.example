# 复制本文件为 .env 并填入你自己的 key（yking 启动时会自动读取）
YKING_API_KEY=sk-xxxx
YKING_MODEL=deepseek-chat
YKING_BASE_URL=https://api.deepseek.com

# 其他 OpenAI 兼容服务商（改 BASE_URL / MODEL 即可，key 用对应平台的）：
#   智谱 GLM : https://open.bigmodel.cn/api/paas/v4               + glm-4.6
#   Kimi     : https://api.moonshot.cn/v1                         + moonshot-v1-32k
#   Qwen     : https://dashscope.aliyuncs.com/compatible-mode/v1  + qwen-plus
#   OpenAI   : https://api.openai.com/v1                          + gpt-4o
#   Ollama   : http://localhost:11434/v1                          + qwen2.5-coder:7b（key 随便填）

# 可选：设为 1 时 run_command 不再询问直接执行（默认执行前会 y/N 确认）
# YKING_AUTO_APPROVE=0
# 可选：设为 0 关闭流式输出（默认边生成边显示）
# YKING_STREAM=1
